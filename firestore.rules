rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profils : tout joueur connecté peut lire, chacun n'écrit que le sien,
    // et seulement avec un pseudo qui lui appartient.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.pseudo is string
        && request.resource.data.pseudoLower == request.resource.data.pseudo.lower()
        && getAfter(/databases/$(database)/documents/pseudos/$(request.resource.data.pseudoLower)).data.uid == uid
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 8000
        && request.resource.data.friends is list && request.resource.data.friends.size() <= 200;
      allow delete: if false;
    }

    // Réservation des pseudos : un pseudo = un seul joueur.
    match /pseudos/{p} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && p.matches('^[a-z0-9_-]{3,16}$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
