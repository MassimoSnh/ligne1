{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "saloon": {
      ".read": "auth != null",
      "players": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
      "bets": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
      "bj": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
      "chat": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 140"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": { ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !root.child('rooms').child($code).child('players').child(data.child('host').val()).exists())" },
        "players": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "live": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "score": { "$uid": { ".write": "auth != null && auth.uid === $uid" } },
        "ev": { "$id": { ".write": "auth != null && !data.exists()" } },
        "dom": { ".write": "auth != null && root.child('rooms').child($code).child('meta').child('host').val() === auth.uid" }
      }
    }
  }
}
